    <string name="calculators">Calculators</string>
    <string name="calc_sugar">Sugar and potential alcohol</string>
    <string name="calc_sugar_value">Sugar</string>
    <string name="calc_unit">Unit</string>
    <string name="calc_equiv">≈ %1$s °NM · %2$s °Bx · %3$s °Oe · potential alcohol %4$s %% vol</string>
    <string name="calc_sugar_note">Approximate conversions (°Bx ≈ °NM × 1.025, °Oe ≈ °NM × 4.25, 1 °NM ≈ 0.6 % vol). Your must meter or lab result wins.</string>
    <string name="calc_chapt">Chaptalization (doslazení)</string>
    <string name="calc_current">Current sugar</string>
    <string name="calc_target">Target sugar</string>
    <string name="calc_volume">Volume</string>
    <string name="calc_factor">kg per hl per °NM</string>
    <string name="calc_chapt_result">Add %1$s kg sugar (%2$s per hl) → about %3$s %% vol</string>
    <string name="calc_chapt_note">Theory: 1.0 kg sucrose per hl raises the must by 1 °NM. Growers often use 1.1–1.2 to be safe; your 2025 rosé note says 1.2 overshot, so 1.0–1.1 is likely right for you. Mind the legal enrichment limit for your zone.</string>
    <string name="calc_so2">SO₂ from pH</string>
    <string name="calc_ph">pH</string>
    <string name="calc_free_so2">Free SO₂ now</string>
    <string name="calc_target_molecular">Target molecular SO₂</string>
    <string name="calc_so2_result">Need %1$s mg/L free SO₂ (add %2$s mg/L) → %3$s g KMS for %4$s L, or %5$s mL of 10 %% solution</string>
    <string name="calc_so2_note">Molecular SO₂ = free SO₂ / (1 + 10^(pH − 1.81)). 0.5 mg/L is the usual target for dry whites, 0.8 mg/L for extra protection. KMS ≈ 57 % SO₂.</string>
    <string name="calc_acid">Acid adjustment</string>
    <string name="calc_ta_now">TA now</string>
    <string name="calc_ta_target">TA target</string>
    <string name="calc_acid_up">Add %1$s g tartaric acid (%2$s g/L). Expect pH to drop by about %3$s.</string>
    <string name="calc_acid_down">Add about %1$s g potassium bicarbonate (%2$s g/L) to lower TA by %3$s g/L; test on a sample first, part of the drop only comes after cold stabilisation.</string>
    <string name="calc_acid_note">1 g/L tartaric acid raises TA by ≈ 1 g/L and lowers pH by ≈ 0.1. KHCO₃ ≈ 1.2 g/L per 1 g/L TA reduction (0.67 g/L CaCO₃ does the same with more sediment).</string>
    <string name="calc_yan">Yeast nutrition (YAN)</string>
    <string name="calc_yan_now">YAN now</string>
    <string name="calc_pot_alc">Potential alcohol</string>
    <string name="calc_yan_result">Target ≈ %1$s mg/L YAN → deficit %2$s mg/L → about %3$s g/hl DAP (or organic nutrient per label, about 2–3× that)</string>
    <string name="calc_yan_ok">YAN is sufficient for this potential alcohol.</string>
    <string name="calc_yan_note">Targets: ~200 mg/L up to 12.5 % vol, ~250 for 13–14 %, ~300 above. 1 g/hl DAP ≈ 2.1 mg/L YAN; EU cap 100 g/hl DAP. Split additions: a third at pitching, the rest at 1/3 sugar depletion.</string>
